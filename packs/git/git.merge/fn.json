{
  "name": "git.merge",
  "version": 1,
  "description": "Merge source into target in a temporary worktree; conflicts are data, not failures.",
  "in": {
    "repo": "string",
    "source": "string",
    "target": "string",
    "message": "string?",
    "push": "bool?"
  },
  "out": {
    "merged": "bool",
    "sha": "string?",
    "conflicts": {"list": "string"}
  },
  "effects": true,
  "timeout": "10m",
  "slots": {"default": 1},
  "retry": {"transient": 2, "backoff": "30s"}
}
