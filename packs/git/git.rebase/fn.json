{
  "name": "git.rebase",
  "version": 1,
  "description": "Rebase a worktree onto a ref; conflicts abort and are returned as data.",
  "in": {
    "path": "string",
    "onto": "string"
  },
  "out": {
    "ok": "bool",
    "sha": "string",
    "conflicts": {"list": "string"}
  },
  "effects": true,
  "timeout": "10m",
  "slots": {"default": 1},
  "retry": {"transient": 2, "backoff": "30s"}
}
