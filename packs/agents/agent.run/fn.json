{
  "name": "agent.run",
  "doc": "Run a spec on the agent engine named in the input. For codex, model is sol (default), astra or luna and effort defaults to high (sol, astra) or max (luna); claude always runs Opus.",
  "open": true,
  "inputs": {
    "engine": {
      "type": "enum",
      "symbols": [
        "devin",
        "codex",
        "claude"
      ]
    },
    "cwd": "string",
    "spec": "string",
    "model": "string?",
    "effort": [
      "null",
      {
        "type": "enum",
        "symbols": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    ],
    "session": "string?",
    "report_path": "string?",
    "listen": "boolean?"
  },
  "outputs": {
    "final": "string",
    "report": "string?",
    "session": "string"
  }
}
