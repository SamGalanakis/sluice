{
  "name": "agent.codex",
  "doc": "Run a Codex session on a spec text in a working directory. Models: sol (default) and astra; effort defaults to high.",
  "open": true,
  "inputs": {
    "cwd": "string",
    "spec": "string",
    "model": [
      "null",
      {
        "type": "enum",
        "symbols": [
          "sol",
          "astra"
        ]
      }
    ],
    "effort": [
      "null",
      {
        "type": "enum",
        "symbols": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    ],
    "log": "string?",
    "session": "string?",
    "report_path": "string?",
    "listen": "boolean?"
  },
  "outputs": {
    "log": "string",
    "final": "string",
    "report": "string?",
    "session": "string"
  }
}
