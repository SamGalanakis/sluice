{
  "name": "agent.run",
  "version": 1,
  "description": "Run a spec on the agent engine named in the input.",
  "in": {
    "engine": ["devin", "codex", "claude"],
    "cwd": "string",
    "spec": "string",
    "model": "string?",
    "resume": "string?",
    "report_path": "string?"
  },
  "out": {
    "final": "string",
    "report": "string?",
    "session": "string?"
  },
  "effects": true,
  "timeout": "4h",
  "slots": {"agent": 1},
  "retry": {"transient": 3, "backoff": "10m"}
}
