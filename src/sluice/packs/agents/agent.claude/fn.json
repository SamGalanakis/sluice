{
  "name": "agent.claude",
  "version": 1,
  "description": "Run a Claude session on a prompt in a working directory.",
  "in": {
    "cwd": "string",
    "prompt": "string",
    "model": "string?",
    "session": "string?"
  },
  "out": {
    "result": "string",
    "session": "string",
    "cost_usd": "float?"
  },
  "effects": true,
  "timeout": "4h",
  "slots": {"agent": 1},
  "retry": {"transient": 3, "backoff": "10m"}
}
