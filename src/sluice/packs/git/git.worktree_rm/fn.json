{
  "name": "git.worktree_rm",
  "version": 1,
  "description": "Remove a git worktree; reports whether the path was a worktree.",
  "in": {
    "repo": "string",
    "path": "string",
    "force": "bool?"
  },
  "out": {
    "removed": "bool"
  },
  "effects": true,
  "timeout": "10m",
  "slots": {"default": 1},
  "retry": {"transient": 2, "backoff": "30s"}
}
