#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "$(realpath "$0")")/.." && pwd)
exec python3 - "$repo" "$@" <<'PY'
import hashlib, json, os, pathlib, shutil, subprocess, sys, tempfile
repo = pathlib.Path(sys.argv[1])
if len(sys.argv) != 3:
    sys.exit('Usage: scripts/build-release <prefix>')
prefix = pathlib.Path(sys.argv[2]).resolve()
protected = [pathlib.Path.home() / '.sluice', pathlib.Path.home() / '.local/bin']
if prefix == pathlib.Path('/') or any(p == prefix or p in prefix.parents for p in protected) or any(prefix == pathlib.Path(p).resolve() for p in os.get_exec_path()):
    sys.exit('Refusing live-home or PATH release prefix')
if os.environ.get('SLUICE_TEST') == '1' and (pathlib.Path.home() / '.local/share/sluice') in [prefix, *prefix.parents]:
    sys.exit('Tests refuse the live release prefix')
prefix.mkdir(parents=True, exist_ok=True)
for child in ['releases', 'bin', '.build']:
    if (prefix / child).is_symlink():
        sys.exit('Refusing symlink output: ' + child)
(prefix / '.build/tmp').mkdir(parents=True, exist_ok=True)
os.environ['TMPDIR'] = str(prefix / '.build/tmp')
sha = os.environ.get('SLUICE_BUILD_GIT_SHA') or subprocess.check_output(['git', '-C', str(repo), 'rev-parse', 'HEAD'], text=True).strip()
# One shared Cargo feature graph; all build outputs are inside the explicit prefix.
build_env = os.environ.copy()
for key in ('CARGO_TARGET_DIR', 'CARGO_BUILD_TARGET_DIR'): build_env.pop(key, None)
subprocess.run(['cargo', 'build', '--target-dir', str(prefix / '.build/target'), '--workspace', '--bins', '--release', '--locked'], cwd=repo, env=build_env, check=True)
def fsync_tree(root):
    for path in root.rglob('*'):
        if path.is_file() and not path.is_symlink():
            with path.open('rb') as f: os.fsync(f.fileno())
    for path in sorted([root, *[p for p in root.rglob('*') if p.is_dir()]], key=lambda p: len(p.parts), reverse=True):
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
        try: os.fsync(fd)
        finally: os.close(fd)
releases = prefix / 'releases'
releases.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(prefix='.stage-', dir=releases) as staging:
    stage = pathlib.Path(staging) / 'release'
    (stage / 'bin').mkdir(parents=True)
    shutil.copy2(prefix / '.build/target/release/sluice', stage / 'bin/sluice')
    shutil.copytree(repo / 'python', stage / 'python', ignore=shutil.ignore_patterns('__pycache__', '*.pyc'))
    # Build/cache the approved artifact entirely under this prefix.
    tmux_cache = prefix / '.build/private-tmux'
    if not (tmux_cache / 'tmux-manifest.json').is_file():
        subprocess.run([str(repo / 'scripts/build-private-tmux'), str(tmux_cache)], check=True, stdout=sys.stderr)
    shutil.copytree(tmux_cache, stage / 'tmux')
    (stage / 'assets').mkdir()
    assets = repo / 'crates/sluice-web/assets'
    if assets.is_dir():
        shutil.copytree(assets, stage / 'assets', dirs_exist_ok=True)
    # The licences of the faces the dashboard serves, beside the manifest of their bytes:
    # licenses/fonts/<family>/LICENSE and licenses/fonts/SHA256SUMS.
    fonts = repo / 'crates/sluice-web/assets/fonts'
    licences = sorted(fonts.glob('*/LICENSE'))
    if not licences or not (fonts / 'SHA256SUMS').is_file():
        sys.exit('build-release: the font licences or their SHA256SUMS are missing')
    for licence in licences:
        target = stage / 'licenses/fonts' / licence.parent.name / 'LICENSE'
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(licence, target)
    shutil.copy2(fonts / 'SHA256SUMS', stage / 'licenses/fonts/SHA256SUMS')
    # Builtin definitions are embedded, so no copied packs are installed.
    # The schema the binary reads and writes: a release whose schema differs from the home's
    # goes out only through scripts/deploy --schema-cutover. Asked of the binary itself, with a
    # scratch home so nothing it starts can reach a real one.
    probe = pathlib.Path(tempfile.mkdtemp(prefix='schema-', dir=prefix / '.build/tmp'))
    try:
        schema = json.loads(subprocess.check_output([str(stage / 'bin/sluice'), 'home', 'schema'], text=True,
            env=dict({k: v for k, v in os.environ.items() if not k.startswith('SLUICE_') or k == 'SLUICE_TEST'},
                     SLUICE_HOME=str(probe / 'home'), SLUICE_INSTALL_DIR=str(probe / 'install'))))['schema']
    finally:
        shutil.rmtree(probe, ignore_errors=True)
    if not isinstance(schema, int) or schema < 1: sys.exit('build-release: bin/sluice reports no schema')
    # The release id is <git sha>-<sha256 of `files` as serde_json writes the manifest's
    # BTreeMap<String, String>> (release::verify recomputes it so): compact, keys in the byte
    # order of their UTF-8, `"`, `\` and control characters escaped (\u00xx in lower-case
    # hex), nothing else ('/' and non-ASCII as they are). Python's json.dumps with these
    # arguments escapes exactly so; the order is given here, by bytes, never by Path order, which
    # puts `a/x` before `a-b/x`. A name that is not UTF-8 has no String: refused.
    files = {}
    for p in stage.rglob('*'):
        if not p.is_file(): continue
        name = str(p.relative_to(stage))
        try: name.encode('utf-8')
        except UnicodeEncodeError: sys.exit('build-release: %r is not a UTF-8 file name' % name)
        files[name] = hashlib.sha256(p.read_bytes()).hexdigest()
    files = dict(sorted(files.items(), key=lambda item: item[0].encode('utf-8')))
    digest = hashlib.sha256(json.dumps(files, separators=(',', ':'), ensure_ascii=False).encode('utf-8')).hexdigest()
    release_id = sha + '-' + digest
    manifest = dict(release_id=release_id, git_sha=sha, guardian_protocol_major=1, guardian_protocol_minor=0, files=files,
                    private_tmux=json.loads((stage / 'tmux/tmux-manifest.json').read_text()),
                    build_toolchain={tool: subprocess.check_output([tool, '--version'], text=True).strip() for tool in ['rustc', 'cargo', 'cc']},
                    schema=schema)
    (stage / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    # The staged binary must accept its own release, with the check `install select` runs: a
    # release it would refuse is never published.
    probe = pathlib.Path(tempfile.mkdtemp(prefix='verify-', dir=prefix / '.build/tmp'))
    try:
        verified = subprocess.run([str(stage / 'bin/sluice'), 'install', 'verify', str(stage)], capture_output=True, text=True,
            env=dict({k: v for k, v in os.environ.items() if not k.startswith('SLUICE_') or k == 'SLUICE_TEST'},
                     SLUICE_HOME=str(probe / 'home'), SLUICE_INSTALL_DIR=str(probe / 'install')))
    finally:
        shutil.rmtree(probe, ignore_errors=True)
    if verified.returncode:
        sys.exit('build-release: bin/sluice refuses the release it was built into: %s' % (verified.stdout.strip() or verified.stderr.strip()))
    fsync_tree(stage)
    destination = releases / release_id
    if destination.exists():
        if (destination / 'manifest.json').read_bytes() != (stage / 'manifest.json').read_bytes():
            sys.exit('Existing release id has different metadata')
    else:
        stage.rename(destination)
        fd = os.open(releases, os.O_RDONLY | os.O_DIRECTORY)
        try: os.fsync(fd)
        finally: os.close(fd)
# A small native entry uses an atomically replaced bootstrap symlink. The selected
# binary re-reads selection.json, so a concurrent switch cannot mix the home pair.
launcher_dir = prefix / 'bin'
launcher_dir.mkdir(exist_ok=True)
with tempfile.TemporaryDirectory(prefix='.launcher-', dir=prefix) as work:
    source = pathlib.Path(work) / 'entry.rs'
    source.write_text('''use std::{os::unix::process::CommandExt, path::PathBuf, process::Command};
fn main() {
    let dir = std::env::var_os("SLUICE_INSTALL_DIR").map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from(std::env::var_os("HOME").expect("HOME is absent")).join(".local/share/sluice/install"));
    let error = Command::new(dir.join("entry")).arg("--installation-entry").arg(&dir)
        .args(std::env::args_os().skip(1)).exec();
    eprintln!("sluice installation entry: {error}"); std::process::exit(1);
}
''')
    binary = pathlib.Path(work) / 'sluice'
    subprocess.run(['rustc', '--edition=2024', '-C', 'opt-level=s', '-C', 'strip=symbols', str(source), '-o', str(binary)], check=True)
    with binary.open('rb') as f: os.fsync(f.fileno())
    binary.replace(launcher_dir / 'sluice')
    fd = os.open(launcher_dir, os.O_RDONLY | os.O_DIRECTORY)
    try: os.fsync(fd)
    finally: os.close(fd)
print(destination)
PY
